<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <title>Music Store</title>
        <link rel="stylesheet" href="styles/main.css" type="text/css"/>
    </head>

    <body>

        <h1>Music Store</h1>
        <p class="subtitle">Choose an album to download</p>

        <div class="albums">

            <div class="album">
                <div class="album-icon">&#9835;</div>
                <h2>Tony Ann</h2>
                <p>Instrumental Music</p>

                <a class="album-button"
                   href="download?action=checkUser&amp;productCode=8601">
                    View Album
                </a>
            </div>

            <div class="album">
                <div class="album-icon">&#9835; &#9835;</div>
                <h2>Charlie Puth</h2>
                <p>Pop Music</p>

                <a class="album-button"
                   href="download?action=checkUser&amp;productCode=pf01">
                    View Album
                </a>
            </div>

        </div>

    </body>
</html>